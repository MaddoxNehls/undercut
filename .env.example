# Postgres (docker compose maps it to 5447 by default)
DATABASE_URL=postgres://undercut:undercut@127.0.0.1:5447/undercut

# Protects POST /api/cron/tick (Vercel Cron sends it as a Bearer token)
CRON_SECRET=change-me

# Cloud worker (apps/worker): server URL + a token from `pnpm admin create-collector --kind cloud`
UNDERCUT_SERVER_URL=http://localhost:3210
UNDERCUT_COLLECTOR_TOKEN=
