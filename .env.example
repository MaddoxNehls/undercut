# Postgres (docker compose maps it to 5447 by default)
DATABASE_URL=postgres://undercut:undercut@127.0.0.1:5447/undercut

# Protects POST /api/cron/tick (Vercel Cron sends it as a Bearer token)
CRON_SECRET=change-me

# Cloud worker (apps/worker): server URL + a token from `pnpm admin create-collector --kind cloud`
UNDERCUT_SERVER_URL=http://localhost:3210
UNDERCUT_COLLECTOR_TOKEN=

# Alerts (M4). Dev defaults point at docker compose: Mailpit SMTP 5452 (UI 5451), ntfy 5453.
SMTP_URL=smtp://127.0.0.1:5452
NTFY_URL=http://127.0.0.1:5453
# Generate with: node -e "console.log(require('web-push').generateVAPIDKeys())" (run in packages/notify)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# LLM-assisted extraction (M3): none | anthropic | openrouter | claude-cli | replay
UNDERCUT_LLM=none
# ANTHROPIC_API_KEY= / OPENROUTER_API_KEY= / UNDERCUT_LLM_REPLAY=path/to/fixture.json
